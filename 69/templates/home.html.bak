<script type="module">
/* ── СЕТЬ ИНТЕЛЛЕКТА В ГЕРОЕ ────────────────────────────────────────
   Зачем: владелец отверг прежний визуал («нет визуала который вызывает
   уважение»). Смысл, который обязана передать сцена — интеллект,
   развитие и движение к цели («достичь своих жизненных целей,
   пользуясь своим интеллектом»).

   Визуал: поток узлов и связей, идущий слева вправо и собирающийся
   к цели. Не симметричная сфера — та читалась как «скринсейвер».

   Если модуль не загрузится, герой остаётся рабочим: фото и текст
   на месте, просто без слоя сети. Поэтому всё в try/catch. */
try {
  /* Прямой путь вместо importmap: тот не разрешал спецификатор 'three'
     и сеть молча не запускалась. */
  const THREE = await import('./vendor/three.module.js');
  const mod = await import('./design/components/hero-net.js');
  const cv = document.getElementById('heroNet');
  const net = (cv && mod.initHeroNet) ? mod.initHeroNet(cv, { THREE }) : null;
  if (net) {
    const hero = document.getElementById('hero');
    const onScroll = function () {
      if (!hero) return;
      const h = hero.offsetHeight - window.innerHeight;
      net.setProgress(h > 0 ? Math.max(0, Math.min(1, window.scrollY / h)) : 0);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    window.__heroNet = net;
  }
} catch (e) {
  if (window.console) console.warn('сеть героя не запустилась:', e && e.message);
}
</script>

<script>
/* ── ПОЯВЛЕНИЕ ПРИ ПРОКРУТКЕ ───────────────────────────────────────
   Обычный обработчик, а не только IntersectionObserver: при включённом
   «уменьшить движение» наблюдатель не срабатывает, и страница остаётся
   серым текстом. Это уже случалось — владелец видел «сухой» сайт. */
(function () {
  var pending = [].slice.call(document.querySelectorAll('.reveal'));
  function check() {
    var h = window.innerHeight || document.documentElement.clientHeight;
    for (var i = pending.length - 1; i >= 0; i--) {
      var r = pending[i].getBoundingClientRect();
      if (r.top < h * 0.9 && r.bottom > 0) {
        pending[i].classList.add('is-in');
        pending.splice(i, 1);
      }
    }
  }
  window.addEventListener('scroll', check, { passive: true });
  window.addEventListener('resize', check);
  window.addEventListener('load', function () { check(); setTimeout(check, 300); });
  check();
})();

/* ── ГЕРОЙ: ЗАТЕМНЕНИЕ БЕЗ РЫВКА ──────────────────────────────────
   В проде затемнение включалось скачком на последних процентах.
   Здесь ровная шкала: 0 → 0.35 → 0.7 → 1 по мере прокрутки героя. */
(function () {
  var hero = document.getElementById('hero');
  var shade = document.getElementById('shade');
  if (!hero || !shade) return;

  function frame() {
    var rect = hero.getBoundingClientRect();
    var total = rect.height - window.innerHeight;
    if (total <= 0) { shade.style.setProperty('--shade', 0); return; }
    var p = Math.min(1, Math.max(0, -rect.top / total));
    /* ступенчатая, но БЕЗ разрыва: три отрезка со сглаживанием */
    var v;
    if (p < 0.5)      v = (p / 0.5) * 0.35;
    else if (p < 0.8) v = 0.35 + ((p - 0.5) / 0.3) * 0.35;
    else              v = 0.70 + ((p - 0.8) / 0.2) * 0.30;
    shade.style.setProperty('--shade', Math.min(1, v).toFixed(3));
  }
  window.addEventListener('scroll', function () { window.requestAnimationFrame(frame); }, { passive: true });
  window.addEventListener('resize', frame);
  frame();

  /* шапка уплотняется, когда герой прокручен */
  var head = document.querySelector('.head');
  window.addEventListener('scroll', function () {
    if (!head) return;
    head.classList.toggle('is-solid', window.scrollY > window.innerHeight * 0.72);
  }, { passive: true });
})();

/* ── ПЕРЕКЛЮЧАТЕЛЬ ТЕМЫ ────────────────────────────────────────────
   Одно нажатие меняет весь сайт. Выбор сохраняется. */
(function () {
  var btns = [].slice.call(document.querySelectorAll('.themes button'));
  if (!btns.length) return;

  function apply(t) {
    document.documentElement.setAttribute('data-theme', t);
    btns.forEach(function (b) {
      b.setAttribute('aria-pressed', b.getAttribute('data-theme-set') === t ? 'true' : 'false');
    });
    try { localStorage.setItem('theme', t); } catch (e) {}
  }

  btns.forEach(function (b) {
    b.addEventListener('click', function () { apply(b.getAttribute('data-theme-set')); });
  });

  /* отметить текущую тему на кнопках при загрузке */
  apply(document.documentElement.getAttribute('data-theme') || 'dark');
})();
</script>
