<script>
/* ТЕМА ПРИМЕНЯЕТСЯ ДО ОТРИСОВКИ.
   Если ставить её обычным скриптом в конце, при перезагрузке сначала
   мелькает тёмный фон, потом светлый — это заметно и дёшево выглядит. */
(function () {
  try {
    var saved = localStorage.getItem('theme');
    var sys = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', saved || sys);
  } catch (e) {}
})();
</script>
