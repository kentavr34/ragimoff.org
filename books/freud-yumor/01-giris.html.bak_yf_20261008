<h2 class="kitab-title">Kitabın sifarişi</h2>

    <p class="kitab-desc">Kitab artıq nəşr olunub və çap nüsxəsi hazırdır. Sifariş etdiyiniz nüsxəni şəxsən imzalayıb, istənilən ünvana poçtla göndərəcəyəm. Təxmini qiymət — 100&nbsp;$; sizin üçün ağırdırsa, aşağıda endirim sorğusu göndərə bilərsiniz.</p>

    <form id="kitab-form">

      <div class="kitab-field">

        <label for="kitab-name">Ad Soyad</label>

        <input id="kitab-name" name="name" type="text" placeholder="Adınız və soyadınız" required autocomplete="name">

      </div>

      <div class="kitab-field">

        <label for="kitab-phone">Mobil nömrə</label>

        <input id="kitab-phone" name="phone" type="tel" placeholder="+994 XX XXX XX XX" required autocomplete="tel">

      </div>

        <div class="kitab-field">

          <label for="kitab-lang">Kitabın dili</label>

          <select id="kitab-lang" name="lang"><option value="az" lang="az" selected>Azərbaycan</option><option value="ru" lang="ru">Русский</option><option value="en" lang="en">English</option><option value="tr" lang="tr">Türkçe</option></select>

        </div>

        <div class="kitab-field">

          <label for="kitab-cls">Əsas təsnifat</label>

          <select id="kitab-cls" name="classification"><option value="XBT-11">XBT-11 (ICD-11)</option><option value="DSM-5-TR">DSM-5-TR</option></select></div>
        <div class="kitab-field">
          <button type="button" id="kitab-geo" class="kitab-geo-btn">📍 Mövqeyimi təyin et</button>
          <div class="kitab-geo-status" id="kitab-geo-status"></div>
        </div>
        <div class="kitab-field-row">
          <div class="kitab-field"><label for="kitab-country">Ölkə</label><input id="kitab-country" name="country" type="text" placeholder="Azərbaycan" autocomplete="country-name"></div>
          <div class="kitab-field"><label for="kitab-postal">Poçt indeksi</label><input id="kitab-postal" name="postal" type="text" placeholder="AZ1000" autocomplete="postal-code"></div>
        </div>
        <div class="kitab-field"><label for="kitab-city">Şəhər</label><input id="kitab-city" name="city" type="text" placeholder="Bakı" autocomplete="address-level2"></div>
        <div class="kitab-field"><label for="kitab-street">Küçə, ev, mənzil</label><textarea id="kitab-street" name="street" rows="2" placeholder="Tam ünvan" required autocomplete="street-address"></textarea></div>
        <div class="kitab-field">
          <label for="kitab-discount">Endirim sorğusu (istəyə bağlı)</label>
          <select id="kitab-discount" name="discount"><option value="0%" selected>0%</option><option value="10%">10%</option><option value="20%">20%</option><option value="30%">30%</option><option value="40%">40%</option><option value="50%">50%</option></select>
        </div>



      <button type="submit" class="kitab-submit">Sifariş et</button>

    </form>

    <div id="kitab-success" class="kitab-success" style="display:none">

      Təşəkkür edirik!<br>Çatdırılma detallarını dəqiqləşdirmək üçün tezliklə sizinlə əlaqə saxlayacağıq.

    </div>

  </div>

</div>

<script>
(function(){
  var btn = document.getElementById('kitab-geo');
  if (!btn) return;
  var status = document.getElementById('kitab-geo-status');
  var cCountry = document.getElementById('kitab-country');
  var cCity = document.getElementById('kitab-city');
  var cPostal = document.getElementById('kitab-postal');
  var cStreet = document.getElementById('kitab-street');
  btn.addEventListener('click', function(){
    if (!navigator.geolocation) {
      status.textContent = 'Brauzeriniz mövqe müəyyənləşdirməni dəstəkləmir.';
      status.className = 'kitab-geo-status err';
      return;
    }
    btn.disabled = true;
    status.className = 'kitab-geo-status';
    status.textContent = 'Mövqeyiniz müəyyənləşdirilir…';
    navigator.geolocation.getCurrentPosition(function(pos){
      var lat = pos.coords.latitude, lon = pos.coords.longitude;
      fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lon + '&addressdetails=1&accept-language=az')
        .then(function(r){ return r.json(); })
        .then(function(d){
          var a = (d && d.address) || {};
          if (a.country) cCountry.value = a.country;
          if (a.postcode) cPostal.value = a.postcode;
          var city = a.city || a.town || a.village || a.municipality || a.county;
          if (city) cCity.value = city;
          var street = [a.road, a.house_number].filter(Boolean).join(' ');
          if (street) cStreet.value = street;
          status.textContent = 'Ünvan dolduruldu — yoxlayıb lazım gələrsə düzəldin.';
          btn.disabled = false;
        })
        .catch(function(){
          status.textContent = 'Ünvan tapılmadı, zəhmət olmasa əl ilə daxil edin.';
          status.className = 'kitab-geo-status err';
          btn.disabled = false;
        });
    }, function(){
      status.textContent = 'İcazə verilmədi — ünvanı əl ilə daxil edin.';
      status.className = 'kitab-geo-status err';
      btn.disabled = false;
    }, { timeout: 10000 });
  });
})();
</script>
<script>

(function(){

  var KITAB_API = 'https://script.google.com/macros/s/AKfycbw-ejwk4wslNpEhMB11Yknj5cjPBZJkoc4nf8BTMP8lxROc8ZxtAWkkXtgv5E8GLzxyfw/exec';

 var BOOK_API = 'https://api.ragimoff.org/api/book-order';

  window.openKitabModal = function(){

    document.getElementById('kitab-modal').classList.add('open');

    document.body.style.overflow = 'hidden';

    setTimeout(function(){ document.getElementById('kitab-name').focus(); }, 120);

  };

  window.closeKitabModal = function(){

    document.getElementById('kitab-modal').classList.remove('open');

    document.body.style.overflow = '';

  };

  document.addEventListener('DOMContentLoaded', function(){

    var form = document.getElementById('kitab-form');

    if (!form) return;

    form.addEventListener('submit', async function(e){

      e.preventDefault();

      var btn = form.querySelector('button[type="submit"]');

      var name  = (document.getElementById('kitab-name').value || '').trim();

      var phone = (document.getElementById('kitab-phone').value || '').trim();

        var address = (function(){
          var country = (document.getElementById('kitab-country').value || '').trim();
          var city    = (document.getElementById('kitab-city').value || '').trim();
          var postal  = (document.getElementById('kitab-postal').value || '').trim();
          var street  = (document.getElementById('kitab-street').value || '').trim();
          return [street, city, postal, country].filter(Boolean).join(', ');
        })();

        var discount = document.getElementById('kitab-discount') ? document.getElementById('kitab-discount').value : '0%';

        var langEl = document.getElementById('kitab-lang');

        var clsEl  = document.getElementById('kitab-cls');

        var lang = langEl ? langEl.value : '';

        var langName = langEl ? langEl.options[langEl.selectedIndex].text : '';

        var cls  = clsEl ? clsEl.value : '';

      if (!name || !phone || !address) { alert('Zəhmət olmasa Ad Soyad, Telefon və Ünvanı daxil edin.'); return; }

      var parts = name.split(/\s+/);

      var payload = {

        type: 'registration',

        fname: parts[0] || '',

        lname: parts.slice(1).join(' ') || '',

        phone: phone,

        service: 'Kitab sifarişi — ' + langName + ' / ' + cls,

          lang: lang,

          classification: cls,

        source: 'klinik-psixiatriya/kitab-sifarisi',

          address: address,

          discount: discount

      };

      if (btn) { btn.textContent = 'Göndərilir...'; btn.disabled = true; }

      try {

        fetch(BOOK_API, { method:'POST', headers:{'Content-Type':'text/plain;charset=utf-8'}, body: JSON.stringify(payload) }).catch(function(){});

 await fetch(KITAB_API, { method:'POST', mode:'no-cors',

          headers:{'Content-Type':'text/plain;charset=utf-8'},

          body: JSON.stringify(payload) });

      } catch(err) { console.error(err); }

      var waMsg = '📚 Kitab sifarişi\nAd: ' + name + '\nTelefon: ' + phone + '\nDil: ' + langName + '\nTəsnifat: ' + cls + '\nÜnvan: ' + address + '\nEndirim: ' + discount;

        window.open('https://wa.me/994702200376?text=' + encodeURIComponent(waMsg), '_blank');

        document.getElementById('kitab-success').style.display = 'block';

      form.style.display = 'none';

    });

    // ESC закрывает

    document.addEventListener('keydown', function(e){

      if (e.key === 'Escape') closeKitabModal();

    });

  });

})();

</script>

