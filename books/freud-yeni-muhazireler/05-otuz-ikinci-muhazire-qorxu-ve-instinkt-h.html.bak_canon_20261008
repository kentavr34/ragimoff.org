.content-wrap h3{font-size:1.02rem;line-height:1.35;margin:1.15rem 0 .4rem;color:var(--text)}

.content-wrap table{font-size:.92rem}

/* методики — каждая отдельным блоком с чётким разделителем и воздухом */

.method-list dt{font-weight:700;color:var(--text);margin-top:1.4rem;padding-top:1rem;border-top:1px solid var(--border);line-height:1.35}

