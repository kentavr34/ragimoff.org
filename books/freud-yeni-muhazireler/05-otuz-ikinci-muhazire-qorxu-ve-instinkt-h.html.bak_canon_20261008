.toc-ch{--tc-col:5.4rem}.cls-panel[data-cls="icd"] .toc-ch{--tc-col:7rem}.cls-panel[data-cls="dsm"] .toc-ch{--tc-col:10.1rem}.cls-panel[data-cls="icd10"] .toc-ch{--tc-col:6.8rem}.toc-ch>a,.toc-ch .tc-head{display:grid;grid-template-columns:var(--tc-col) 1fr;align-items:baseline;gap:.6rem;padding:.8rem 1rem;text-decoration:none;color:var(--text);font-weight:700;font-size:.95rem;letter-spacing:.01em;background:var(--bg3)}

