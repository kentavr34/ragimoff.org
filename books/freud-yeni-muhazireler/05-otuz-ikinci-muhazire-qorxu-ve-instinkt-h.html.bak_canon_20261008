<script>
(function(){
  var btn = document.getElementById('kitab-geo');
  if (!btn) return;
  var status = document.getElementById('kitab-geo-status');
  var cCountry = document.getElementById('kitab-country');
  var cCity = document.getElementById('kitab-city');
  var cPostal = document.getElementById('kitab-postal');
  var cStreet = document.getElementById('kitab-street');
  btn.addEventListener('click', function(){
    if (!navigator.geolocation) {
      status.textContent = 'Brauzeriniz mövqe müəyyənləşdirməni dəstəkləmir.';
      status.className = 'kitab-geo-status err';
      return;
    }
    btn.disabled = true;
    status.className = 'kitab-geo-status';
    status.textContent = 'Mövqeyiniz müəyyənləşdirilir…';
    navigator.geolocation.getCurrentPosition(function(pos){
      var lat = pos.coords.latitude, lon = pos.coords.longitude;
      fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lon + '&addressdetails=1&accept-language=az')
        .then(function(r){ return r.json(); })
        .then(function(d){
          var a = (d && d.address) || {};
          if (a.country) cCountry.value = a.country;
          if (a.postcode) cPostal.value = a.postcode;
          var city = a.city || a.town || a.village || a.municipality || a.county;
          if (city) cCity.value = city;
          var street = [a.road, a.house_number].filter(Boolean).join(' ');
          if (street) cStreet.value = street;
          status.textContent = 'Ünvan dolduruldu — yoxlayıb lazım gələrsə düzəldin.';
          btn.disabled = false;
        })
        .catch(function(){
          status.textContent = 'Ünvan tapılmadı, zəhmət olmasa əl ilə daxil edin.';
          status.className = 'kitab-geo-status err';
          btn.disabled = false;
        });
    }, function(){
      status.textContent = 'İcazə verilmədi — ünvanı əl ilə daxil edin.';
      status.className = 'kitab-geo-status err';
      btn.disabled = false;
    }, { timeout: 10000 });
  });
})();
</script>
<script>

(function(){

