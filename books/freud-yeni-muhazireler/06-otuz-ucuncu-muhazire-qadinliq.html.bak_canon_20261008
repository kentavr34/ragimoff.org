const ALL_PAGES = [{"slug": "index", "title": "Yeni mühazirələr", "code": ""}, {"slug": "01-on-soz", "title": "Ön söz", "code": "01"}, {"slug": "02-iyirmi-doqquzuncu-muhazire-yuxu-nezeriyy", "title": "İyirmi doqquzuncu mühazirə. YUXU NƏZƏRİYYƏSİNƏ YENİDƏN BAXIŞ", "code": "02"}, {"slug": "03-otuzuncu-muhazire-yuxu-ve-okkultizm", "title": "Otuzuncu mühazirə. YUXU VƏ OKKULTİZM", "code": "03"}, {"slug": "04-otuz-birinci-muhazire-psixi-sexsiyyetin", "title": "Otuz birinci mühazirə. PSİXİ ŞƏXSİYYƏTİN PARÇALANMASI", "code": "04"}, {"slug": "05-otuz-ikinci-muhazire-qorxu-ve-instinkt-h", "title": "Otuz ikinci mühazirə. TƏLAŞ VƏ HƏVƏS HƏYATI", "code": "05"}, {"slug": "06-otuz-ucuncu-muhazire-qadinliq", "title": "Otuz üçüncü mühazirə. QADINLIQ", "code": "06"}, {"slug": "07-otuz-dorduncu-muhazire-izahlar-tetbiqler", "title": "Otuz dördüncü mühazirə. İZAHLAR, TƏTBİQLƏR, ORİYENTASİYALAR", "code": "07"}, {"slug": "08-otuz-besinci-muhazire-dunyagorusu-haqqin", "title": "Otuz beşinci mühazirə. DÜNYAGÖRÜŞÜ HAQQINDA", "code": "08"}];



// Sidebar active

document.querySelectorAll('.nav-link').forEach(a=>{

  if(a.getAttribute('data-slug')===CURRENT) a.classList.add('active');

});



// Progress bar

const pf = document.getElementById('prog-fill');

const btt = document.getElementById('btt');

window.addEventListener('scroll',()=>{

  const s=window.scrollY, t=document.body.scrollHeight-window.innerHeight;

  if(pf) pf.style.width=(t>0?s/t*100:0)+'%';

  if(btt) btt.classList.toggle('on',s>400);

});



// Search — full-text index (lazy loaded from search-index.json)

let _srIdx=null,_srLoading=false;

function _srLoad(cb){

  if(_srIdx){cb(_srIdx);return;}

  if(_srLoading){setTimeout(()=>_srLoad(cb),80);return;}

  _srLoading=true;

  fetch('/klinik-psixiatriya/search-index.json')

    .then(r=>r.json())

    .then(d=>{_srIdx=d;_srLoading=false;cb(d);})

    .catch(()=>{_srIdx=[];_srLoading=false;cb([]);});

}



const si=document.getElementById('search-input');

const sd=document.getElementById('search-drop');

if(si&&sd){

  si.addEventListener('focus',()=>_srLoad(()=>{}),{once:true});

  let tmr;

  si.addEventListener('input',()=>{

    clearTimeout(tmr);

    tmr=setTimeout(()=>{

      const q=si.value.trim().toLowerCase();

      if(q.length<2){sd.classList.remove('on');return;}

      _srLoad(idx=>{

        const esc=q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');

        const re=new RegExp(esc,'gi');

        const hl=s=>s?String(s).replace(re,m=>'<mark>'+m+'</mark>'):s;

        const res=idx.filter(x=>(x.title+' '+(x.codes||'')+' '+(x.text||'')).toLowerCase().includes(q)).slice(0,20);

        if(!res.length){sd.innerHTML='<div class="sr"><div class="sr-title">Nəticə tapılmadı</div></div>';sd.classList.add('on');return;}

        sd.innerHTML=res.map(r=>{

          let snip='';

          const txt=r.text||'';

          const lo=txt.toLowerCase();

          const i2=lo.indexOf(q);

          if(i2>=0){const s=Math.max(0,i2-50);snip=txt.slice(s,s+140).trim();}

          else{

            const co=(r.codes||'').toLowerCase();

            const i3=co.indexOf(q);

            if(i3>=0){const s=Math.max(0,i3-30);snip=(r.codes||'').slice(s,s+120).trim();}

          }

          return `<div class="sr" onclick="goTo('${r.page}','${r.id}')">

            <div class="sr-title">${hl(r.title)}</div>

            ${snip?`<div class="sr-snip">${hl(snip)}</div>`:''}

            <div class="sr-sub">${r.sub||r.page+'.html'}</div></div>`;

        }).join('');

        sd.classList.add('on');

      });

    },200);

  });

  document.addEventListener('click',e=>{if(!e.target.closest('.hdr-search'))sd.classList.remove('on');});

  si.addEventListener('keydown',e=>{if(e.key==='Escape'){si.value='';sd.classList.remove('on');}});

}



function goTo(page,id){

  sd&&sd.classList.remove('on');

  if(page===CURRENT&&id){

    const el=document.getElementById(id);

    if(el){el.scrollIntoView({behavior:'smooth',block:'start'});return;}

  }

  window.location.href=page+'.html'+(id?'#'+id:'');

}



var _sbScroll=0;

function toggleSb(){

  var sb=document.getElementById('sb'),ov=document.getElementById('ov');

  if(sb.classList.contains('on')){

    _sbScroll=sb.scrollTop;

    sb.classList.remove('on');

    if(ov) ov.classList.remove('on');

  } else {

    sb.classList.add('on');

    if(ov) ov.classList.add('on');

    setTimeout(function(){sb.scrollTop=_sbScroll;},10);

  }

}

function closeSb(){

  var sb=document.getElementById('sb'),ov=document.getElementById('ov');

  if(sb){_sbScroll=sb.scrollTop;sb.classList.remove('on');}

  if(ov) ov.classList.remove('on');

}

// Закрыть сайдбар при клике по любой ссылке внутри (мобильный)

var sbNav=document.querySelector('#sb nav');

if(sbNav){

  sbNav.addEventListener('click',function(e){

    if(window.innerWidth<960){

      var a=e.target.closest('a');

      if(a) setTimeout(closeSb, 80);

    }

  });

}

// Закрыть по Escape

document.addEventListener('keydown',function(e){

  if(e.key==='Escape') closeSb();

});

document.getElementById('btt')?.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));

</script>



<script>

(function(){

  // Auto-expand active chapter

  var slug = document.querySelector('.nav-link[data-slug]') &&

             document.querySelector('h1[id]') ? null : null;

  // Find current slug from active link

  var path = location.pathname.split('/').pop().replace('.html','');

  document.querySelectorAll('.nav-has-sub').forEach(function(item){

    if(item.dataset.slug === path){

      item.classList.add('open');

    }

  });

  // Highlight active link

  document.querySelectorAll('.nav-link').forEach(function(a){

    if(a.dataset.slug === path) a.classList.add('active');

  });

  // Scroll sidebar to show active chapter

  setTimeout(function(){

    var sb=document.getElementById('sb');

    var open=sb&&sb.querySelector('.nav-has-sub.open');

    if(sb&&open){

      var target=open.offsetTop-Math.round(sb.offsetHeight/3);

      sb.scrollTop=Math.max(0,target);

    }

  },80);

})();



function toggleSub(btn){

  var sb=document.getElementById('sb');

  var top=sb?sb.scrollTop:0;

  var item=btn.closest('.nav-has-sub');

  item.classList.toggle('open');

  if(sb) requestAnimationFrame(function(){sb.scrollTop=top;});

}

</script>





<!-- ── Kitabın Sifarişi Modal ─────────────────────────── -->

<div id="kitab-modal" class="kitab-overlay" onclick="if(event.target===this)closeKitabModal()">

  <div class="kitab-box">

    <button class="kitab-close" onclick="closeKitabModal()" aria-label="Bağla">✕</button>

    <div class="kitab-logo">КП</div>

    <h2 class="kitab-title">Kitabın sifarişi</h2>

    <p class="kitab-desc">Kitab artıq nəşr olunub və çap nüsxəsi hazırdır. Sifariş etdiyiniz nüsxəni şəxsən imzalayıb, istənilən ünvana poçtla göndərəcəyəm. Təxmini qiymət — 100&nbsp;$; sizin üçün ağırdırsa, aşağıda endirim sorğusu göndərə bilərsiniz.</p>

    <form id="kitab-form">

      <div class="kitab-field">

        <label for="kitab-name">Ad Soyad</label>

        <input id="kitab-name" name="name" type="text" placeholder="Adınız və soyadınız" required autocomplete="name">

      </div>

      <div class="kitab-field">

        <label for="kitab-phone">Mobil nömrə</label>

        <input id="kitab-phone" name="phone" type="tel" placeholder="+994 XX XXX XX XX" required autocomplete="tel">

      </div>

        <div class="kitab-field">

          <label for="kitab-lang">Kitabın dili</label>

          <select id="kitab-lang" name="lang"><option value="az" lang="az" selected>Azərbaycan</option><option value="ru" lang="ru">Русский</option><option value="en" lang="en">English</option><option value="tr" lang="tr">Türkçe</option></select>

        </div>

        <div class="kitab-field">

          <label for="kitab-cls">Əsas təsnifat</label>

          <select id="kitab-cls" name="classification"><option value="XBT-11">XBT-11 (ICD-11)</option><option value="DSM-5-TR">DSM-5-TR</option></select></div>
        <div class="kitab-field">
          <button type="button" id="kitab-geo" class="kitab-geo-btn">📍 Mövqeyimi təyin et</button>
          <div class="kitab-geo-status" id="kitab-geo-status"></div>
        </div>
        <div class="kitab-field-row">
          <div class="kitab-field"><label for="kitab-country">Ölkə</label><input id="kitab-country" name="country" type="text" placeholder="Azərbaycan" autocomplete="country-name"></div>
          <div class="kitab-field"><label for="kitab-postal">Poçt indeksi</label><input id="kitab-postal" name="postal" type="text" placeholder="AZ1000" autocomplete="postal-code"></div>
        </div>
        <div class="kitab-field"><label for="kitab-city">Şəhər</label><input id="kitab-city" name="city" type="text" placeholder="Bakı" autocomplete="address-level2"></div>
        <div class="kitab-field"><label for="kitab-street">Küçə, ev, mənzil</label><textarea id="kitab-street" name="street" rows="2" placeholder="Tam ünvan" required autocomplete="street-address"></textarea></div>
        <div class="kitab-field">
          <label for="kitab-discount">Endirim sorğusu (istəyə bağlı)</label>
          <select id="kitab-discount" name="discount"><option value="0%" selected>0%</option><option value="10%">10%</option><option value="20%">20%</option><option value="30%">30%</option><option value="40%">40%</option><option value="50%">50%</option></select>
        </div>



      <button type="submit" class="kitab-submit">Sifariş et</button>

    </form>

    <div id="kitab-success" class="kitab-success" style="display:none">

      Təşəkkür edirik!<br>Çatdırılma detallarını dəqiqləşdirmək üçün tezliklə sizinlə əlaqə saxlayacağıq.

    </div>

  </div>

</div>

<script>
(function(){
  var btn = document.getElementById('kitab-geo');
  if (!btn) return;
  var status = document.getElementById('kitab-geo-status');
  var cCountry = document.getElementById('kitab-country');
  var cCity = document.getElementById('kitab-city');
  var cPostal = document.getElementById('kitab-postal');
  var cStreet = document.getElementById('kitab-street');
  btn.addEventListener('click', function(){
    if (!navigator.geolocation) {
      status.textContent = 'Brauzeriniz mövqe müəyyənləşdirməni dəstəkləmir.';
      status.className = 'kitab-geo-status err';
      return;
    }
    btn.disabled = true;
    status.className = 'kitab-geo-status';
    status.textContent = 'Mövqeyiniz müəyyənləşdirilir…';
    navigator.geolocation.getCurrentPosition(function(pos){
      var lat = pos.coords.latitude, lon = pos.coords.longitude;
      fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lon + '&addressdetails=1&accept-language=az')
        .then(function(r){ return r.json(); })
        .then(function(d){
          var a = (d && d.address) || {};
          if (a.country) cCountry.value = a.country;
          if (a.postcode) cPostal.value = a.postcode;
          var city = a.city || a.town || a.village || a.municipality || a.county;
          if (city) cCity.value = city;
          var street = [a.road, a.house_number].filter(Boolean).join(' ');
          if (street) cStreet.value = street;
          status.textContent = 'Ünvan dolduruldu — yoxlayıb lazım gələrsə düzəldin.';
          btn.disabled = false;
        })
        .catch(function(){
          status.textContent = 'Ünvan tapılmadı, zəhmət olmasa əl ilə daxil edin.';
          status.className = 'kitab-geo-status err';
          btn.disabled = false;
        });
    }, function(){
      status.textContent = 'İcazə verilmədi — ünvanı əl ilə daxil edin.';
      status.className = 'kitab-geo-status err';
      btn.disabled = false;
    }, { timeout: 10000 });
  });
})();
</script>
<script>

(function(){

  var KITAB_API = 'https://script.google.com/macros/s/AKfycbw-ejwk4wslNpEhMB11Yknj5cjPBZJkoc4nf8BTMP8lxROc8ZxtAWkkXtgv5E8GLzxyfw/exec';

 var BOOK_API = 'https://api.ragimoff.org/api/book-order';

  window.openKitabModal = function(){

    document.getElementById('kitab-modal').classList.add('open');

    document.body.style.overflow = 'hidden';

    setTimeout(function(){ document.getElementById('kitab-name').focus(); }, 120);

  };

  window.closeKitabModal = function(){

    document.getElementById('kitab-modal').classList.remove('open');

    document.body.style.overflow = '';

  };

  document.addEventListener('DOMContentLoaded', function(){

    var form = document.getElementById('kitab-form');

    if (!form) return;

    form.addEventListener('submit', async function(e){

      e.preventDefault();

      var btn = form.querySelector('button[type="submit"]');

      var name  = (document.getElementById('kitab-name').value || '').trim();

      var phone = (document.getElementById('kitab-phone').value || '').trim();

        var address = (function(){
          var country = (document.getElementById('kitab-country').value || '').trim();
          var city    = (document.getElementById('kitab-city').value || '').trim();
          var postal  = (document.getElementById('kitab-postal').value || '').trim();
          var street  = (document.getElementById('kitab-street').value || '').trim();
          return [street, city, postal, country].filter(Boolean).join(', ');
        })();

        var discount = document.getElementById('kitab-discount') ? document.getElementById('kitab-discount').value : '0%';

        var langEl = document.getElementById('kitab-lang');

        var clsEl  = document.getElementById('kitab-cls');

        var lang = langEl ? langEl.value : '';

        var langName = langEl ? langEl.options[langEl.selectedIndex].text : '';

        var cls  = clsEl ? clsEl.value : '';

      if (!name || !phone || !address) { alert('Zəhmət olmasa Ad Soyad, Telefon və Ünvanı daxil edin.'); return; }

      var parts = name.split(/\s+/);

      var payload = {

        type: 'registration',

        fname: parts[0] || '',

        lname: parts.slice(1).join(' ') || '',

        phone: phone,

        service: 'Kitab sifarişi — ' + langName + ' / ' + cls,

          lang: lang,

          classification: cls,

        source: 'klinik-psixiatriya/kitab-sifarisi',

          address: address,

          discount: discount

      };

      if (btn) { btn.textContent = 'Göndərilir...'; btn.disabled = true; }

      try {

        fetch(BOOK_API, { method:'POST', headers:{'Content-Type':'text/plain;charset=utf-8'}, body: JSON.stringify(payload) }).catch(function(){});

 await fetch(KITAB_API, { method:'POST', mode:'no-cors',

          headers:{'Content-Type':'text/plain;charset=utf-8'},

          body: JSON.stringify(payload) });

      } catch(err) { console.error(err); }

      var waMsg = '📚 Kitab sifarişi\nAd: ' + name + '\nTelefon: ' + phone + '\nDil: ' + langName + '\nTəsnifat: ' + cls + '\nÜnvan: ' + address + '\nEndirim: ' + discount;

        window.open('https://wa.me/994702200376?text=' + encodeURIComponent(waMsg), '_blank');

        document.getElementById('kitab-success').style.display = 'block';

      form.style.display = 'none';

    });

    // ESC закрывает

    document.addEventListener('keydown', function(e){

      if (e.key === 'Escape') closeKitabModal();

    });

  });

})();

</script>

